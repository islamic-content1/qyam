rules_version = '2';

// قواعد حماية Firestore لختمة القيام
// - القراءة: فقط للفتيات الخمس بعد تسجيل الدخول
// - الكتابة: كل فتاة على الشيت الخاص بها فقط
service cloud.firestore {
  match /databases/{database}/documents {

    function allowedEmails() {
      return [
        'manar@qiyam-khatma.app',
        'lour@qiyam-khatma.app',
        'lama@qiyam-khatma.app',
        'haya@qiyam-khatma.app',
        'zeina@qiyam-khatma.app'
      ];
    }

    function isMember() {
      return request.auth != null
        && request.auth.token.email in allowedEmails();
    }

    function isOwner(girl) {
      return isMember()
        && request.auth.token.email == girl + '@qiyam-khatma.app';
    }

    // شكل البيانات المسموح: done و notes فقط، وكلاهما Map
    function validSheet() {
      let d = request.resource.data;
      return d.keys().hasOnly(['done', 'notes'])
        && (!('done' in d) || d.done is map)
        && (!('notes' in d) || d.notes is map)
        && (!('done' in d) || d.done.size() <= 120)
        && (!('notes' in d) || d.notes.size() <= 120);
    }

    match /sheets/{girl} {
      allow read: if isMember();
      allow create, update: if isOwner(girl) && validSheet();
      allow delete: if false;
    }

    // منع أي مسار آخر
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
